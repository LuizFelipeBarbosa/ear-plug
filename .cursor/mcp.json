{
    "mcpServers": {
        "convex": {
            "command": "npx",
            "args": [
                "-y",
                "convex@latest",
                "mcp",
                "start"
            ],
            "env": {}
        },
        "expo-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "expo-mcp@latest"
            ],
            "env": {
                "EXPO_TOKEN": "${EXPO_TOKEN}"
            }
        },
        "google-maps": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-google-maps"
            ],
            "env": {
                "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
            }
        },
        "next-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "next-devtools-mcp@latest"
            ],
            "env": {}
        },
        "clerk": {
            "command": "npx",
            "args": [
                "-y",
                "@clerk/mcp-server@latest"
            ],
            "env": {
                "CLERK_SECRET_KEY": "${CLERK_SECRET_KEY}"
            }
        }
    }
}
