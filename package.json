{
  "name": "ear-plug",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@ear-plug/web",
    "dev:mobile": "turbo dev --filter=@ear-plug/mobile",
    "dev:convex": "convex dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@ear-plug/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "react-native-worklets": "^0.7.4",
    "turbo": "^2.3.0",
    "typescript": "~5.3.3"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.12",
      "bn.js": "5.2.3",
      "brace-expansion": "2.0.3",
      "dompurify": "3.3.2",
      "fast-xml-parser": "4.5.6",
      "lodash": "4.18.1",
      "minimatch": "3.1.4",
      "node-forge": "1.4.0",
      "picomatch": "4.0.4",
      "send": "0.19.0",
      "tar": "7.5.11",
      "undici": "6.24.1",
      "yaml@^1.0.0": "1.10.3",
      "yaml@^2.0.0": "2.8.3"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.0.0",
    "convex": "^1.16.0",
    "svix": "^1.86.0"
  }
}
